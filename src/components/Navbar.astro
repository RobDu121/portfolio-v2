---
import { withBase } from "../utils/paths";
---

<header>
    <nav aria-label="Main navigation">
        <a href={withBase("#home")} class="logo">RD.</a>
        <a href={withBase("#home")}>Home</a>
        <a href={withBase("#about")}>About Me</a>
        <a href={withBase("#skills")}>Skills</a>
        <a href={withBase("#projects")}>Projects</a>
        <a href={withBase("#contact")}>Contact Me</a>
        <a href="https://github.com/RobDu121" target="_blank" rel="noopener noreferrer">My GitHub</a>
    </nav>
</header>

<style>
    header{
        position: sticky;
        top: 0;
        z-index: 100;
    }
    nav{
        min-height: 80px;
        
        padding: 20px 40px;
        background-color: #172338;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 30px;
    }
    nav a{
        color: #ffffff;
        text-decoration: none;
        transition: color 0.3s ease;
    }
    nav a:focus-visible {
        outline: 2px solid #93c5fd;
        outline-offset: 5px;
        border-radius: 4px;
    }
    nav a:hover{
        color: #93c5fd;
    }
    .logo{
        margin-right:auto;
        font-size: 24px;
        color: #60a5fa;
        text-decoration: none;
    }
    @media (max-width: 600px){
        nav{
            flex-wrap: wrap;
            justify-content: center;
            padding: 16px;
            gap: 12px;
            min-height: 0;
        }
        .logo{
            flex-basis: 100%;
            text-align: center;
            margin-right: 0;
        }
    }
</style>
